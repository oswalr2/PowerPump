        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In una padella, soffriggi l'aglio nell'olio d'oliva per 1 minuto a fuoco medio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em uma frigideira, refogue o alho no azeite por 1 minuto em fogo médio."
