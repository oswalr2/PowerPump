        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your torso upright, as if sliding down a wall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el torso recto, como si bajaras pegado a una pared."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde le buste droit, comme si tu descendais le long d'un mur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni il busto dritto, come se scendessi lungo un muro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o tronco reto, como se descesse encostado numa parede."
          }
        }
      }
    },
    "form.rule.lunge.torso.title" : {
