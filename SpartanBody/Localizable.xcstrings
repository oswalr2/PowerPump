        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colle les coudes au corps. Si l'épaule aide, le biceps travaille moins."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni i gomiti vicino al corpo. Se aiuta la spalla, il bicipite lavora meno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha os cotovelos colados ao corpo. Se o ombro ajuda, o bíceps trabalha menos."
          }
        }
      }
    },
