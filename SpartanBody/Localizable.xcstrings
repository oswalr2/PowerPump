          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O queixo não passa da barra"
          }
        }
      }
    },
    "form.rule.pullup.hang.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower until your arms are straight before the next rep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja hasta estirar los brazos antes de la siguiente rep."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redescends jusqu'à avoir les bras tendus avant la rép. suivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scendi fino a distendere le braccia prima della ripetizione successiva."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desça até esticar os braços antes da próxima rep."
          }
        }
      }
    },
    "form.rule.pullup.hang.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not hanging all the way down"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
