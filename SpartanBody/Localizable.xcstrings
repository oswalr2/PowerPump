    },
    "spartan.ask.motivator" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What do we work on today?|Ask me anything, I'm ready!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿En qué trabajamos hoy?|¡Pregúntame lo que quieras, estoy listo!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On travaille sur quoi aujourd'hui ?|Demande-moi ce que tu veux, je suis prêt !"
          }
        },
        "it" : {
