    "Add broccoli and bell pepper. Stir-fry 4 minutes.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega el brócoli y el pimiento. Saltea 4 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez brocoli et poivron. Faites sauter 4 minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi broccoli e peperone. Salta in padella 4 minuti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o brócolis e o pimentão. Refogue por 4 minutos."
          }
        }
      }
    },
    "Add broccoli and season with thyme, garlic, and onion powder.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega el brócoli y sazona con tomillo, ajo y cebolla en polvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le brocoli et assaisonnez avec thym, ail et oignon en poudre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i broccoli e condisci con timo, aglio e cipolla in polvere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o brócolis e tempere com tomilho, alho e cebola em pó."
          }
        }
      }
    },
    "Add cauliflower rice and soy sauce. Stir-fry 5 more minutes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega el arroz de coliflor y salsa de soya. Saltea 5 minutos más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute le riz de chou-fleur et la sauce soja. Fais sauter 5 min de plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il riso di cavolfiore e la salsa di soia. Salta altri 5 min."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o arroz de couve-flor e o molho de soja. Refogue por mais 5 min."
          }
        }
      }
    },
    "Add cherry tomatoes and cook 3-4 minutes until softened.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega los tomates cherry y cocina 3-4 minutos hasta que se ablanden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les tomates cerises et faites cuire 3-4 minutes jusqu'à ce qu'elles ramollissent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i pomodorini e cuoci 3-4 minuti finché si ammorbidiscono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione os tomates-cereja e cozinhe 3-4 minutos até amolecer."
          }
        }
      }
    },
    "Add garlic and sauté for 30 seconds.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega el ajo y sofríe 30 segundos."
          }
        },
        "fr": {
