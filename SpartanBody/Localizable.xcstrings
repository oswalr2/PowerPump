        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun aliment ne fait grossir à lui seul : ce qui compte, c'est le total de la journée. S'il rentre dans ton objectif, c'est parfait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
