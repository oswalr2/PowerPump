          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No extiendes arriba del todo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bras pas tendus en haut"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non distendi del tutto in alto"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não estende totalmente em cima"
          }
        }
      }
    },
    "form.rule.plank.pike.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower your hips into a straight line from head to heels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja la cadera hasta formar una línea recta de la cabeza a los talones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaisse les hanches pour former une ligne droite de la tête aux talons."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbassa i fianchi fino a una linea dritta dalla testa ai talloni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaixe o quadril até formar uma linha reta da cabeça aos calcanhares."
          }
        }
      }
    },
    "form.rule.plank.pike.title" : {
