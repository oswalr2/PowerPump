    "notif.sleep.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good sleep builds muscle and burns fat. Start getting ready for bed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormir bien construye músculo y quema grasa. Empieza a prepararte para dormir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien dormir construit du muscle et brûle des graisses. Prépare-toi à aller au lit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormire bene costruisce muscoli e brucia grassi. Inizia a prepararti per andare a letto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormir bem constrói músculo e queima gordura. Comece a se preparar para dormir."
          }
        }
      }
