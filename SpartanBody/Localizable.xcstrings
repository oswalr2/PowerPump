    "tutorial.progress.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weight and heart-rate charts, weekly trends, achievements and challenges. Everything syncs with Apple Health, and if you have an Apple Watch you can train right from your wrist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gráficas de peso y frecuencia cardíaca, tendencias semanales, logros y retos. Todo se sincroniza con Apple Salud, y si tienes Apple Watch puedes entrenar desde la muñeca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Courbes de poids et de fréquence cardiaque, tendances hebdomadaires, succès et défis. Tout se synchronise avec Apple Santé, et avec une Apple Watch tu peux t'entraîner depuis ton poignet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafici di peso e frequenza cardiaca, tendenze settimanali, traguardi e sfide. Tutto si sincronizza con Apple Salute, e se hai un Apple Watch puoi allenarti dal polso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gráficos de peso e frequência cardíaca, tendências semanais, conquistas e desafios. Tudo sincroniza com o Apple Saúde, e se você tem um Apple Watch dá para treinar direto do pulso."
          }
        }
      }
    },
