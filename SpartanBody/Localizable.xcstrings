            "state": "translated",
            "value": "Vierte pequeños círculos de masa. Cocina 2-3 min por lado hasta dorar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Versez de petits cercles de pâte. Faites cuire 2-3 min par côté jusqu'à dorure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Versa piccoli cerchi di pastella. Cuoci 2-3 min per lato fino a doratura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Despeje pequenos círculos de massa. Cozinhe 2-3 min de cada lado até dourar."
          }
        }
      }
    },
    "Preheat oven to 180°C.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precalienta el horno a 180°C."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préchauffe le four à 180°C."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preriscalda il forno a 180°C."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preaqueça o forno a 180°C."
          }
        }
      }
    },
    "Preheat oven to 200°C. Cube sweet potatoes, toss with 1 tbsp oil and paprika.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precalienta el horno a 200°C. Corta los camotes en cubos y mézclalos con 1 cda de aceite y paprika."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préchauffez le four à 200°C. Coupez les patates douces en cubes, mélangez avec 1 c. à s. d'huile et le paprika."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preriscalda il forno a 200°C. Taglia le patate dolci a cubetti e condiscile con 1 cucchiaio d'olio e paprika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preaqueça o forno a 200°C. Corte as batatas-doces em cubos e misture com 1 c. sopa de azeite e páprica."
          }
        }
      }
    },
    "Press tofu, then pan-fry in sesame oil until golden, ~6 min.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prensa el tofu y fríe en aceite de sésamo hasta dorar, ~6 min."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presse le tofu, puis fais dorer dans l'huile de sésame, ~6 min."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressa il tofu e rosolalo nell'olio di sesamo fino a dorato, ~6 min."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione o tofu e frite no óleo de gergelim até dourar, ~6 min."
          }
        }
      }
    },
