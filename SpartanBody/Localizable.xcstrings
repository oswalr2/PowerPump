    "tutorial.sports.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cycling, swimming, yoga, tennis, boxing and more. Each sport keeps its own history, and outdoor ones record your route on the map too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciclismo, natación, yoga, tenis, boxeo y más. Cada deporte guarda su propio historial, y los de exterior también graban tu ruta en el mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vélo, natation, yoga, tennis, boxe et plus. Chaque sport garde son propre historique, et ceux d'extérieur enregistrent aussi ton parcours sur la carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciclismo, nuoto, yoga, tennis, boxe e altro. Ogni sport ha il suo storico, e quelli all'aperto registrano anche il percorso sulla mappa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciclismo, natação, yoga, tênis, boxe e mais. Cada esporte guarda seu próprio histórico, e os de rua também gravam sua rota no mapa."
          }
        }
      }
    },
