        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lift your hips up and back to form an inverted V. Bend your knees a little if it helps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube la cadera hacia arriba y atrás para formar una V invertida. Dobla un poco las rodillas si ayuda."
          }
        },
        "fr" : {
          "stringUnit" : {
