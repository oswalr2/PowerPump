    "sources.disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerPump offers general fitness and nutrition guidance, not medical advice. If you have a health condition, are pregnant or take medication, talk to your doctor before changing your diet or training."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerPump ofrece orientación general de entrenamiento y nutrición, no consejo médico. Si tienes alguna enfermedad, estás embarazada o tomas medicación, habla con tu médico antes de cambiar tu dieta o tu entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerPump donne des conseils généraux d'entraînement et de nutrition, pas des conseils médicaux. Si tu as un problème de santé, si tu es enceinte ou si tu prends un traitement, parle à ton médecin avant de changer ton alimentation ou ton entraînement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerPump offre indicazioni generali su allenamento e nutrizione, non consigli medici. Se hai una condizione di salute, sei incinta o prendi farmaci, parla con il tuo medico prima di cambiare dieta o allenamento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PowerPump oferece orientação geral de treino e nutrição, não aconselhamento médico. Se você tem alguma condição de saúde, está grávida ou toma medicação, fale com seu médico antes de mudar sua dieta ou seu treino."
          }
        }
      }
    },
