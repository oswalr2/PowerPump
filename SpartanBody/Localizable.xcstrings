    "tutorial.run.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run, walk or hike while the map traces your route live, with pace, distance and calories. It keeps working with the screen locked, and you can watch your stats on the Lock Screen and the Dynamic Island."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre, camina o haz senderismo mientras el mapa dibuja tu ruta en vivo, con ritmo, distancia y calorías. Sigue funcionando con la pantalla bloqueada, y puedes ver tus datos en la pantalla de bloqueo y en la Dynamic Island."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cours, marche ou randonne pendant que la carte trace ton parcours en direct, avec allure, distance et calories. Ça continue même écran verrouillé, et tu vois tes stats sur l'écran de verrouillage et la Dynamic Island."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corri, cammina o fai trekking mentre la mappa traccia il percorso dal vivo, con ritmo, distanza e calorie. Funziona anche a schermo bloccato, e vedi i tuoi dati nella schermata di blocco e nella Dynamic Island."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corra, caminhe ou faça trilha enquanto o mapa desenha sua rota ao vivo, com ritmo, distância e calorias. Continua funcionando com a tela bloqueada, e você acompanha seus dados na tela de bloqueio e na Dynamic Island."
          }
        }
      }
    },
