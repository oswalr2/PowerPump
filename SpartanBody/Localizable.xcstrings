    "Mix Greek yogurt with whey protein until smooth.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezcla el yogur griego con la proteína whey hasta que quede homogéneo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mélangez le yaourt grec avec la whey jusqu'à consistance lisse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mescola lo yogurt greco con le proteine whey fino a ottenere un composto liscio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Misture o iogurte grego com o whey até ficar homogêneo."
          }
        }
      }
    },
    "Mix all ingredients until a smooth batter forms. Add milk if too thick.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezcla todos los ingredientes hasta formar una masa homogénea. Agrega leche si queda muy espesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mélangez tous les ingrédients jusqu'à obtenir une pâte lisse. Ajoutez du lait si elle est trop épaisse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mescola tutti gli ingredienti fino a una pastella liscia. Aggiungi latte se è troppo densa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Misture todos os ingredientes até formar uma massa lisa. Adicione leite se ficar muito grossa."
          }
        }
      }
    },
    "Mix tuna, Greek yogurt, celery, mustard, and lemon juice in a bowl.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezcla el atún, el yogur griego, el apio, la mostaza y el jugo de limón en un bowl."
