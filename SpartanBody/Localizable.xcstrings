    },
    "form.rule.squat.depth.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit down until your thighs are at least parallel to the floor. Lower the weight if you can't reach it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja hasta que los muslos queden al menos paralelos al suelo. Si no llegas, baja el peso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descends jusqu'à ce que les cuisses soient au moins parallèles au sol. Baisse la charge si tu n'y arrives pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scendi finché le cosce sono almeno parallele al pavimento. Se non ci arrivi, riduci il peso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desça até as coxas ficarem pelo menos paralelas ao chão. Se não conseguir, diminua o peso."
          }
        }
      }
    },
