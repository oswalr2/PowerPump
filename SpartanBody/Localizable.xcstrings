    "form.intro.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerPump reads your movement on this iPhone, reviews every rep and deletes its copy of the video when you close the screen. Only the score is saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerPump lee tu movimiento en este iPhone, revisa cada repetición y borra su copia del vídeo al cerrar la pantalla. Solo se guarda la puntuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerPump lit ton mouvement sur cet iPhone, analyse chaque répétition et supprime sa copie de la vidéo quand tu fermes l'écran. Seul le score est enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerPump legge il tuo movimento su questo iPhone, controlla ogni ripetizione ed elimina la sua copia del video quando chiudi la schermata. Viene salvato solo il punteggio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PowerPump lê seu movimento neste iPhone, revisa cada repetição e apaga a cópia do vídeo quando você fecha a tela. Só a pontuação é salva."
          }
        }
      }
    },
