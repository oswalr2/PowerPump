    "form.rule.plank.sag.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuck your pelvis and squeeze your glutes. Better a shorter plank done well."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mete la pelvis y aprieta glúteos. Mejor una plancha más corta bien hecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rentre le bassin et serre les fessiers. Mieux vaut une planche plus courte et bien faite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta il bacino in dentro e stringi i glutei. Meglio un plank più breve fatto bene."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encaixe a pelve e contraia os glúteos. Melhor uma prancha mais curta bem feita."
          }
        }
      }
    },
    "form.rule.plank.sag.title" : {
