    "form.rule.deadlift.squatting.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start with your hips higher. The deadlift is a hip hinge: shins nearly vertical, bar close to the legs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza con la cadera más alta. El peso muerto es una bisagra de cadera: espinillas casi verticales y barra pegada a las piernas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarre avec les hanches plus hautes. C'est une charnière de hanche : tibias presque verticaux, barre près des jambes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parti con i fianchi più alti. Lo stacco è una cerniera d'anca: tibie quasi verticali, bilanciere vicino alle gambe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece com o quadril mais alto. O terra é uma dobradiça de quadril: canelas quase verticais e barra perto das pernas."
          }
        }
      }
    },
    "form.rule.deadlift.squatting.title" : {
