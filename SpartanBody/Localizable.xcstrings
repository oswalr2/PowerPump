    "PowerPump does not use any third-party analytics, advertising SDKs, or tracking tools. We do not track you across apps or websites, and we do not use any third-party AI or language-model services." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerPump no usa analíticas de terceros, SDK de publicidad ni herramientas de rastreo. No te seguimos entre apps o sitios web, y no usamos ningún servicio de IA o modelo de lenguaje de terceros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerPump n'utilise aucun outil d'analyse tiers, SDK publicitaire ou outil de pistage. Nous ne te suivons pas entre les apps ou les sites, et nous n'utilisons aucun service d'IA ou de modèle de langage tiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerPump non usa analytics di terze parti, SDK pubblicitari o strumenti di tracciamento. Non ti tracciamo tra app o siti web e non usiamo alcun servizio di IA o modello linguistico di terze parti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PowerPump não usa analytics de terceiros, SDKs de publicidade nem ferramentas de rastreamento. Não rastreamos você entre apps ou sites, e não usamos nenhum serviço de IA ou modelo de linguagem de terceiros."
          }
        }
      }
    },
    "PowerPump stores all your fitness data (workouts, nutrition logs, goals, measurements) locally on your device only. We do not operate any backend servers or databases." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerPump guarda todos tus datos de fitness (entrenamientos, registros de comida, objetivos, medidas) solo en tu dispositivo. No tenemos servidores ni bases de datos propias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerPump enregistre toutes tes données de fitness (entraînements, journal alimentaire, objectifs, mesures) uniquement sur ton appareil. Nous n'avons aucun serveur ni base de données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PowerPump salva tutti i tuoi dati di fitness (allenamenti, diario alimentare, obiettivi, misure) solo sul tuo dispositivo. Non abbiamo server né database."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PowerPump guarda todos os seus dados de fitness (treinos, registros de refeições, metas, medidas) apenas no seu dispositivo. Não temos servidores nem bancos de dados."
          }
        }
      }
    },
    "PowerPump uses your location to trace your route and measure distance." : {
