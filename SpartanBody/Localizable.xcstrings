    "form.rule.pullup.kip.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your legs still and your core tight. Pull with your back, not with momentum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén las piernas quietas y el abdomen firme. Tira con la espalda, no con impulso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde les jambes immobiles et gaine-toi. Tire avec le dos, pas avec l'élan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni le gambe ferme e l'addome contratto. Tira con la schiena, non con lo slancio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha as pernas paradas e o abdômen firme. Puxe com as costas, não com impulso."
          }
        }
      }
    },
