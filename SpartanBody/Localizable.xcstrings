    "chat.error.offTopic" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That's outside my field 😅 I'm your fitness coach: ask me about training, food, sleep or recovery and I'm all yours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eso se sale de lo mío 😅 Soy tu coach de fitness: pregúntame sobre entrenamiento, comida, sueño o recuperación y soy todo tuyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça sort de mon domaine 😅 Je suis ton coach fitness : pose-moi tes questions sur l'entraînement, l'alimentation, le sommeil ou la récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo è fuori dal mio campo 😅 Sono il tuo coach di fitness: chiedimi di allenamento, cibo, sonno o recupero e sono tutto tuo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso foge da minha área 😅 Sou seu coach de fitness: pergunte sobre treino, alimentação, sono ou recuperação e estou aqui."
          }
        }
      }
    },
    "chat.error.refused" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I can't help with that one. Ask me about training, nutrition, supplements or recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
