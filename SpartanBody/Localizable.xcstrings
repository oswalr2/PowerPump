    "form.rule.tree.balance.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fix your gaze on a still point and engage your core. Place the foot on the calf instead of the thigh if you need to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija la mirada en un punto quieto y activa el abdomen. Apoya el pie en la pantorrilla en vez del muslo si lo necesitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixe un point immobile et gaine-toi. Pose le pied sur le mollet plutôt que la cuisse si besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fissa lo sguardo su un punto fermo e attiva l'addome. Appoggia il piede sul polpaccio invece che sulla coscia se serve."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixe o olhar num ponto parado e ative o abdômen. Apoie o pé na panturrilha em vez da coxa se precisar."
          }
        }
      }
