    "Season chicken and grill or pan-sear 6 min per side. Let rest, then slice.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sazona el pollo y ásalo a la parrilla o sartén 6 min por lado. Deja reposar y córtalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assaisonnez le poulet et grillez-le ou saisissez-le 6 min par côté. Laissez reposer, puis tranchez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condisci il pollo e griglialo o scottalo in padella 6 min per lato. Fai riposare, poi affetta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempere o frango e grelhe ou frite 6 min de cada lado. Deixe descansar e fatie."
