    "form.rule.pullup.chin.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pull until your chin clears the bar. Use a band or negatives until you can."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tira hasta que la barbilla pase la barra. Usa una banda o negativas hasta lograrlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire jusqu'à ce que le menton dépasse la barre. Utilise un élastique ou des négatives en attendant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tira finché il mento supera la sbarra. Usa un elastico o le negative finché non ci riesci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puxe até o queixo passar da barra. Use elástico ou negativas até conseguir."
          }
        }
      }
    },
    "form.rule.pullup.chin.title" : {
      "extractionState" : "manual",
