    "coach.analysis.gainMuscle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At %d kg, your plan follows a classic push/pull/legs split — the most proven approach for hypertrophy. Combined with a slight calorie surplus and high protein intake, this programme will drive consistent muscle growth week over week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con %d kg, tu plan sigue una división clásica de empuje/tirón/piernas — el enfoque más probado para la hipertrofia. Combinado con un ligero superávit calórico y alta ingesta de proteínas, este programa impulsará un crecimiento muscular constante semana tras semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À %d kg, votre plan suit la classique division push/pull/jambes — l'approche la plus éprouvée pour l'hypertrophie. Combiné à un léger surplus calorique et une haute consommation de protéines, ce programme générera une croissance musculaire constante semaine après semaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con %d kg, il tuo piano segue la classica divisione spinta/tiro/gambe — l'approccio più collaudato per l'ipertrofia. Combinato con un leggero surplus calorico e un alto apporto proteico, questo programma guiderà una crescita muscolare costante settimana dopo settimana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com %d kg, seu plano segue a clássica divisão push/pull/legs — a abordagem mais comprovada para hipertrofia. Combinado com um leve superávit calórico e alta ingestão de proteínas, este programa promoverá crescimento muscular consistente semana após semana."
          }
        }
      }
    },
    "coach.analysis.loseWeight": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current BMI is %.1f (%@). This plan combines calorie-deficit nutrition with a mix of strength training and cardio to maximise fat loss while preserving muscle mass. Expect visible progress within 4–6 weeks of consistent effort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu IMC actual es %.1f (%@). Este plan combina nutrición con déficit calórico y entrenamiento de fuerza y cardio para maximizar la pérdida de grasa preservando músculo. Espera progreso visible en 4–6 semanas de esfuerzo constante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre IMC actuel est %.1f (%@). Ce plan combine une alimentation déficitaire en calories et un mix de musculation et de cardio pour maximiser la perte de graisse tout en préservant la masse musculaire. Attendez des progrès visibles en 4–6 semaines d'effort constant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo IMC attuale è %.1f (%@). Questo piano combina nutrizione con deficit calorico e un mix di allenamento e cardio per massimizzare la perdita di grasso preservando la massa muscolare. Aspettati progressi visibili in 4–6 settimane di impegno costante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu IMC atual é %.1f (%@). Este plano combina nutrição com déficit calórico e treino de força e cardio para maximizar a perda de gordura preservando músculo. Espere progresso visível em 4–6 semanas de esforço consistente."
          }
        }
      }
    },
    "coach.analysis.stayFit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile shows a balanced starting point. This full-body maintenance plan keeps you strong, mobile, and energised without overtraining. It alternates strength and cardio days to build well-rounded fitness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu perfil muestra un punto de partida equilibrado. Este plan de mantenimiento de cuerpo completo te mantiene fuerte, móvil y lleno de energía sin sobreentrenar. Alterna días de fuerza y cardio para construir una condición física integral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre profil montre un point de départ équilibré. Ce plan de maintien full-body vous garde fort, mobile et énergisé sans surentraînement. Il alterne des jours de force et de cardio pour développer une condition physique complète."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo profilo mostra un punto di partenza equilibrato. Questo piano di mantenimento full-body ti mantiene forte, mobile ed energico senza sovrallenarsi. Alterna giorni di forza e cardio per costruire una forma fisica completa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu perfil mostra um ponto de partida equilibrado. Este plano de manutenção full-body mantém você forte, ágil e energizado sem treinar demais. Alterna dias de força e cardio para construir uma aptidão física completa."
          }
        }
      }
    },
    "coach.motivation.gainMuscle": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strength is built in the moments you want to stop but don't — trust the process, add weight to the bar, and your body will respond."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuerza se construye en los momentos en que quieres parar pero no lo haces — confía en el proceso, añade peso a la barra y tu cuerpo responderá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La force se construit dans les moments où vous voulez arrêter mais ne le faites pas — faites confiance au processus, ajoutez du poids à la barre et votre corps répondra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La forza si costruisce nei momenti in cui vuoi fermarti ma non lo fai — fidati del processo, aggiungi peso al bilanciere e il tuo corpo risponderà."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A força é construída nos momentos em que você quer parar mas não para — confie no processo, adicione peso na barra e seu corpo vai responder."
          }
        }
      }
    },
    "coach.motivation.gainMuscle.v2": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muscle is built one rep at a time. Today's session is tomorrow's strength."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El músculo se construye repetición a repetición. La sesión de hoy es la fuerza de mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le muscle se construit une rép à la fois. La séance d'aujourd'hui est la force de demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il muscolo si costruisce una ripetizione alla volta. La sessione di oggi è la forza di domani."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O músculo se constrói uma repetição de cada vez. O treino de hoje é a força de amanhã."
          }
        }
      }
    },
    "coach.motivation.gainMuscle.v3": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iron never lies: show up, lift, grow. Spartans are forged, not born."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El hierro nunca miente: preséntate, levanta, crece. Los espartanos se forjan, no nacen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fonte ne ment jamais : présente-toi, soulève, progresse. Les spartiates se forgent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ferro non mente mai: presentati, solleva, cresci. Gli spartani si forgiano, non nascono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ferro nunca mente: apareça, levante, cresça. Espartanos são forjados, não nascem."
          }
        }
      }
    },
    "coach.motivation.loseWeight": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every rep, every meal, every night of good sleep is a vote for the person you're becoming — stay consistent and the results will follow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada repetición, cada comida, cada noche de buen sueño es un voto por la persona en la que te estás convirtiendo — mantente constante y los resultados llegarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque répétition, chaque repas, chaque nuit de bon sommeil est un vote pour la personne que vous devenez — restez constant et les résultats suivront."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni ripetizione, ogni pasto, ogni notte di buon sonno è un voto per la persona che stai diventando — rimani costante e i risultati arriveranno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada repetição, cada refeição, cada noite de bom sono é um voto pela pessoa que você está se tornando — mantenha a consistência e os resultados virão."
          }
        }
      }
    },
    "coach.motivation.loseWeight.v2": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small steps every day burn the biggest fires. Keep showing up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pasos pequeños de cada día encienden los fuegos más grandes. Sigue presentándote."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les petits pas de chaque jour allument les plus grands feux. Continue de te présenter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I piccoli passi di ogni giorno accendono i fuochi più grandi. Continua a presentarti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequenos passos todos os dias acendem as maiores chamas. Continue aparecendo."
          }
        }
      }
    },
    "coach.motivation.loseWeight.v3": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have to be perfect — just consistent. Your future self is watching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes que ser perfecto — solo constante. Tu yo del futuro te está viendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n'as pas besoin d'être parfait — juste régulier. Ton futur toi te regarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non devi essere perfetto — solo costante. Il te del futuro ti sta guardando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não precisa ser perfeito — só constante. O seu eu do futuro está de olho."
          }
        }
      }
    },
    "coach.motivation.stayFit": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The best workout is the one you keep doing — build habits that fit your life and fitness will take care of itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mejor entrenamiento es el que sigues haciendo — construye hábitos que se ajusten a tu vida y el fitness se cuidará solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le meilleur entraînement est celui que vous continuez à faire — créez des habitudes qui s'adaptent à votre vie et la forme physique s'occupera d'elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il miglior allenamento è quello che continui a fare — costruisci abitudini che si adattino alla tua vita e il fitness si prenderà cura di sé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O melhor treino é aquele que você continua fazendo — construa hábitos que se encaixem na sua vida e o fitness cuidará de si mesmo."
          }
        }
      }
    },
    "coach.motivation.stayFit.v2": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health is the quiet victory you win every single day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salud es la victoria silenciosa que ganas todos los días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La santé est la victoire silencieuse que tu gagnes chaque jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La salute è la vittoria silenziosa che vinci ogni giorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A saúde é a vitória silenciosa que você conquista todos os dias."
          }
        }
      }
    },
    "coach.motivation.stayFit.v3": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move today so you can keep moving for decades. Your body thanks you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muévete hoy para seguir moviéndote por décadas. Tu cuerpo te lo agradece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouge aujourd'hui pour continuer à bouger pendant des décennies. Ton corps te remercie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Muoviti oggi per continuare a muoverti per decenni. Il tuo corpo ti ringrazia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova-se hoje para continuar se movendo por décadas. Seu corpo agradece."
          }
        }
      }
    },
