    "spartan.memory.injury" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You told me %@. Skip anything that hurts and tell me how it's going."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me dijiste %@. Evita lo que te moleste y cuéntame cómo va."
