    "tutorial.gym.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start an empty workout or follow a routine. Log sets, reps and weight with one tap. There's a rest timer, and the app remembers your personal records for every exercise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza un entreno vacío o sigue una rutina. Apunta series, repeticiones y peso con un toque. Tienes temporizador de descanso, y la app recuerda tus récords en cada ejercicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance une séance vide ou suis une routine. Note séries, répétitions et poids d'un geste. Il y a un minuteur de repos, et l'app retient tes records sur chaque exercice."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia un allenamento vuoto o segui una routine. Segna serie, ripetizioni e peso con un tocco. C'è il timer di recupero, e l'app ricorda i tuoi record per ogni esercizio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece um treino vazio ou siga uma rotina. Anote séries, repetições e peso com um toque. Tem timer de descanso, e o app lembra seus recordes em cada exercício."
          }
        }
      }
    },
