    "tutorial.dashboard.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ring shows your calories. Below it you'll find your macros, water, streak and shortcuts to log food or start training. Everything updates as you go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El anillo muestra tus calorías. Debajo tienes tus macros, el agua, tu racha y accesos rápidos para registrar comida o empezar a entrenar. Todo se actualiza solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'anneau affiche tes calories. En dessous, tes macros, l'eau, ta série et des raccourcis pour enregistrer un repas ou t'entraîner. Tout se met à jour tout seul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'anello mostra le tue calorie. Sotto trovi i macro, l'acqua, la tua serie e le scorciatoie per registrare i pasti o allenarti. Si aggiorna tutto da solo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O anel mostra suas calorias. Abaixo ficam os macros, a água, sua sequência e atalhos para registrar comida ou começar a treinar. Tudo se atualiza sozinho."
          }
        }
      }
    },
