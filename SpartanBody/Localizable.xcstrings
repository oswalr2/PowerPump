          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les hanches montent avant la barre"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I fianchi salgono prima del bilanciere"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O quadril sobe antes da barra"
          }
        }
      }
    },
    "form.rule.deadlift.lockout.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the top, squeeze your glutes and stand straight. Without leaning back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arriba, aprieta glúteos y quédate recto, sin echarte hacia atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En haut, serre les fessiers et tiens-toi droit, sans te pencher en arrière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In alto, stringi i glutei e stai dritto, senza inclinarti indietro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No alto, contraia os glúteos e fique reto, sem jogar o corpo para trás."
          }
        }
      }
    },
    "form.rule.deadlift.lockout.title" : {
