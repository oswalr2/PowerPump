    "spartan.recap.title.buddy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nice one, %@, another session done.|Well done, %@. How are you feeling?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien hecho, %@, una sesión más.|Muy bien, %@. ¿Qué tal te has sentido?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien joué, %@, une séance de plus.|Bravo, %@. Comment tu te sens ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ben fatto, %@, un'altra sessione.|Bravo, %@. Come ti senti?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mandou bem, %@, mais um treino.|Muito bem, %@. Como você se sentiu?"
          }
        }
      }
    },
