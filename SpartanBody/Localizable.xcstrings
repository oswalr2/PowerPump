    "form.rule.rdl.knees.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep a slight, fixed knee bend. The movement comes from the hips, not the knees."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén una flexión de rodilla leve y fija. El movimiento sale de la cadera, no de las rodillas."
          }
        },
        "fr" : {
          "stringUnit" : {
