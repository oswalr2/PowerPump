    "form.rule.tempo.fast.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take about 2 seconds on the way down. Control builds more muscle and protects your joints."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tómate unos 2 segundos en la bajada. El control construye más músculo y protege las articulaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prends environ 2 secondes pour descendre. Le contrôle développe plus de muscle et protège les articulations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impiega circa 2 secondi in discesa. Il controllo costruisce più muscolo e protegge le articolazioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leve cerca de 2 segundos na descida. O controle constrói mais músculo e protege as articulações."
          }
        }
      }
