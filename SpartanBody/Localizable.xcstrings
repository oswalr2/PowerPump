    "review.empty" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your first weekly review arrives when your first full week ends. Log workouts and meals and it'll be ready."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu primer resumen llega cuando termine tu primera semana completa. Registra entrenos y comidas y estará listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton premier bilan arrive à la fin de ta première semaine complète. Enregistre séances et repas et il sera prêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo primo riepilogo arriva alla fine della prima settimana completa. Registra allenamenti e pasti e sarà pronto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu primeiro resumo chega quando sua primeira semana completa terminar. Registre treinos e refeições e ele estará pronto."
          }
        }
      }
    },
