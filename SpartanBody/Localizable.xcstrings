    "spartan.recap.title.motivator" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workout done, %@! 🔥|Beast mode, %@! 💪|That's how it's done, %@!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Entreno terminado, %@! 🔥|¡Bestia, %@! 💪|¡Así se hace, %@!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séance terminée, %@ ! 🔥|Quelle machine, %@ ! 💪|C'est comme ça qu'on fait, %@ !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allenamento finito, %@! 🔥|Una bestia, %@! 💪|Così si fa, %@!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treino concluído, %@! 🔥|Monstro, %@! 💪|É assim que se faz, %@!"
          }
        }
      }
    },
