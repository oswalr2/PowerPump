    "form.rule.pushup.depth.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower until your chest is a fist from the floor. If you can't, do them on your knees or on a bench."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja hasta que el pecho quede a un puño del suelo. Si no puedes, hazlas de rodillas o en un banco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descends jusqu'à ce que la poitrine soit à un poing du sol. Sinon, fais-les sur les genoux ou sur un banc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scendi finché il petto è a un pugno dal pavimento. Se non ci riesci, falli sulle ginocchia o su una panca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desça até o peito ficar a um punho do chão. Se não conseguir, faça com os joelhos apoiados ou num banco."
          }
        }
      }
    },
