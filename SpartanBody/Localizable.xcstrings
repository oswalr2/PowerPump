    "review.focus.activity" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You averaged %d steps a day. Outside the gym you barely move. A 20-minute walk after meals adds up fast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiciste %d pasos al día de media. Fuera del gym apenas te mueves: caminar 20 minutos después de comer suma rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as fait %d pas par jour en moyenne. Hors de la salle tu bouges peu : 20 minutes de marche après les repas, ça compte vite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai fatto in media %d passi al giorno. Fuori dalla palestra ti muovi poco: 20 minuti di camminata dopo i pasti fanno la differenza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você deu %d passos por dia em média. Fora da academia você quase não se mexe: caminhar 20 minutos depois de comer soma rápido."
          }
        }
      }
    },
    "review.focus.logging" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You logged meals on %d of 7 days. Without data the coach can't adjust your calories. Even a rough log is better than none."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registraste comidas %d de 7 días. Sin datos el coach no puede ajustar tus calorías: aunque sea aproximado, es mejor que nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as enregistré tes repas %d jours sur 7. Sans données, le coach ne peut pas ajuster tes calories : même approximatif, c'est mieux que rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai registrato i pasti %d giorni su 7. Senza dati il coach non può regolare le calorie: anche approssimativo è meglio di niente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você registrou refeições em %d de 7 dias. Sem dados o coach não consegue ajustar suas calorias: mesmo aproximado, é melhor que nada."
          }
        }
      }
    },
    "review.focus.none" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything scored well. Keep the same routine. Consistency is what turns a good week into results."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo salió bien. Mantén la misma rutina: la constancia es lo que convierte una buena semana en resultados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout s'est bien passé. Garde la même routine : c'est la régularité qui transforme une bonne semaine en résultats."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto è andato bene. Mantieni la stessa routine: è la costanza a trasformare una buona settimana in risultati."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo foi bem. Mantenha a mesma rotina: é a constância que transforma uma boa semana em resultados."
          }
        }
      }
    },
    "review.focus.protein" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You averaged %d g of protein out of %d. Add a protein source to every meal. The snack in your menu is there to close that gap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegaste a %d g de proteína de media de %d. Añade una fuente de proteína en cada comida: la merienda de tu menú está para cerrar ese hueco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as atteint %d g de protéines en moyenne sur %d. Ajoute une source de protéines à chaque repas : la collation de ton menu est là pour combler l'écart."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai raggiunto in media %d g di proteine su %d. Aggiungi una fonte proteica a ogni pasto: lo spuntino del tuo menù serve a colmare la differenza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você chegou a %d g de proteína em média de %d. Inclua uma fonte de proteína em cada refeição: o lanche do seu cardápio está aí para fechar essa diferença."
          }
        }
      }
    },
    "review.focus.recovery" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your resting heart rate was %d bpm above your normal and your HRV %d%% below it: your body isn't recovering. Sleep more and take the heavy sessions easier this week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pulso en reposo estuvo %d ppm por encima de lo normal y tu HRV un %d%% por debajo: tu cuerpo no está recuperando. Duerme más y baja la intensidad de los días pesados esta semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta fréquence cardiaque au repos était %d bpm au-dessus de la normale et ta VFC %d%% en dessous : ton corps ne récupère pas. Dors plus et allège les séances lourdes cette semaine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua frequenza a riposo era %d bpm sopra il normale e la tua HRV il %d%% sotto: il corpo non sta recuperando. Dormi di più e alleggerisci i giorni pesanti questa settimana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua frequência em repouso ficou %d bpm acima do normal e sua VFC %d%% abaixo: seu corpo não está se recuperando. Durma mais e pegue leve nos dias pesados nesta semana."
          }
        }
      }
    },
    "review.focus.sleep" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You slept %d h %02d on average. It's what's holding your recovery back most. Aim for 7 h 30: same bedtime every day, screens off 30 minutes before."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dormiste %d h %02d de media. Es lo que más frena tu recuperación: apunta a 7 h 30, misma hora de acostarte cada día y pantallas fuera 30 minutos antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as dormi %d h %02d en moyenne. C'est ce qui freine le plus ta récupération : vise 7 h 30, même heure de coucher chaque jour et écrans éteints 30 minutes avant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai dormito in media %d h %02d. È ciò che frena di più il recupero: punta a 7 h 30, stesso orario per andare a letto e schermi spenti 30 minuti prima."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você dormiu %d h %02d em média. É o que mais atrapalha sua recuperação: mire em 7 h 30, mesmo horário de dormir todo dia e telas desligadas 30 minutos antes."
          }
        }
      }
    },
    "review.focus.training" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You did %d of %d workouts. Put the ones you missed in your calendar like an appointment. And if the plan doesn't fit your week, the coach will trim it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiciste %d de %d entrenos. Pon los que faltaron en tu calendario como una cita; si el plan no encaja en tu semana, el coach lo recortará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as fait %d séances sur %d. Mets celles que tu as manquées dans ton agenda comme un rendez-vous ; si le plan ne rentre pas dans ta semaine, le coach l'allègera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai fatto %d allenamenti su %d. Segna quelli saltati in calendario come un appuntamento; se il piano non si adatta alla tua settimana, il coach lo ridurrà."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você fez %d de %d treinos. Coloque os que faltaram na agenda como um compromisso; se o plano não couber na sua semana, o coach vai reduzi-lo."
          }
        }
      }
    },
