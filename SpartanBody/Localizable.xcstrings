    "In a pan, sauté garlic in olive oil for 1 minute over medium heat.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una sartén, sofríe el ajo en aceite de oliva 1 minuto a fuego medio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans une poêle, faites revenir l'ail dans l'huile d'olive 1 minute à feu moyen."
