    "form.rule.squat.chest.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your chest up and brace your core. Push your knees out so your hips can drop between them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el pecho arriba y el abdomen firme. Abre las rodillas para que la cadera baje entre ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde la poitrine haute et gaine-toi. Pousse les genoux vers l'extérieur pour que les hanches descendent entre eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni il petto alto e l'addome contratto. Spingi le ginocchia in fuori per far scendere i fianchi tra di esse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o peito erguido e o abdômen firme. Abra os joelhos para o quadril descer entre eles."
          }
        }
      }
    },
    "form.rule.squat.chest.title" : {
      "extractionState" : "manual",
