        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au fil de ta progression, augmente peu à peu le poids et réduis les répétitions pour continuer à défier ta force."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
