    "form.rule.curl.bottom.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower the weight until your arms are almost straight. Half reps leave half the muscle untrained."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja el peso hasta casi estirar los brazos. Las medias reps dejan medio músculo sin trabajar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descends jusqu'à avoir les bras presque tendus. Les demi-rép. laissent la moitié du muscle de côté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbassa il peso finché le braccia sono quasi distese. Le mezze ripetizioni allenano metà muscolo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desça o peso até os braços ficarem quase esticados. Meias reps deixam metade do músculo sem trabalhar."
          }
        }
      }
    },
