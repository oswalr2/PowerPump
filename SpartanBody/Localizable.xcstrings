      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the standing leg long and strong, without locking the knee hard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la pierna de apoyo larga y firme, sin bloquear la rodilla con fuerza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde la jambe d'appui longue et solide, sans verrouiller le genou."
          }
        },
        "it" : {
          "stringUnit" : {
