    "Cook chicken 6-7 min per side until golden and cooked through. Rest 2 min, then slice.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocina el pollo 6-7 min por lado hasta que esté dorado y bien cocido. Deja reposar 2 min y córtalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites cuire le poulet 6-7 min par côté jusqu'à ce qu'il soit doré et bien cuit. Laissez reposer 2 min, puis tranchez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuoci il pollo 6-7 min per lato finché è dorato e ben cotto. Fai riposare 2 min, poi affetta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinhe o frango 6-7 min de cada lado até dourar e cozinhar por completo. Deixe descansar 2 min e fatie."
          }
        }
      }
    },
    "Cook pasta according to package instructions. Reserve ¼ cup pasta water.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocina la pasta según las instrucciones del paquete. Reserva ¼ de taza del agua de cocción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites cuire les pâtes selon les instructions du paquet. Réservez ¼ de tasse d'eau de cuisson."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuoci la pasta secondo le istruzioni della confezione. Tieni da parte ¼ di tazza di acqua di cottura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinhe o macarrão conforme a embalagem. Reserve ¼ de xícara da água do cozimento."
          }
        }
      }
    },
    "Cook quinoa according to package (usually 2:1 water ratio, 15 min).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocina la quinoa según el paquete (normalmente 2:1 de agua, 15 min)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites cuire le quinoa selon le paquet (généralement ratio eau 2:1, 15 min)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuoci la quinoa secondo la confezione (di solito acqua 2:1, 15 min)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinhe a quinoa conforme a embalagem (geralmente 2:1 de água, 15 min)."
          }
        }
      }
    },
    "Cook zucchini 2-3 min. Add lemon juice and dill.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocina el calabacín 2-3 min. Agrega jugo de limón y eneldo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites cuire les courgettes 2-3 min. Ajoutez jus de citron et aneth."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuoci le zucchine 2-3 min. Aggiungi succo di limone e aneto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinhe a abobrinha 2-3 min. Adicione suco de limão e endro."
          }
        }
      }
    },
