    "tutorial.nutrition.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the barcode of any packaged product or search the food database. There are healthy recipes too, including vegan options, and a tap logs each glass of water."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el código de barras de cualquier producto o busca en la base de alimentos. También tienes recetas saludables, con opciones veganas, y cada vaso de agua se apunta con un toque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne le code-barres d'un produit ou cherche dans la base d'aliments. Tu as aussi des recettes saines, avec des options véganes, et chaque verre d'eau se note d'un geste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona il codice a barre di un prodotto o cerca nel database alimenti. Ci sono anche ricette sane, con opzioni vegane, e ogni bicchiere d'acqua si segna con un tocco."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneie o código de barras de qualquer produto ou busque no banco de alimentos. Também tem receitas saudáveis, com opções veganas, e cada copo de água entra com um toque."
          }
        }
      }
    },
