    "tutorial.ready.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A good way to start: log today's first meal or hit the gym. The more you use PowerPump, the more the dashboard tells you. You can replay this tour anytime from Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una buena forma de empezar: registra tu primera comida de hoy o dale al gym. Cuanto más uses PowerPump, más te cuenta el panel de inicio. Puedes repetir este recorrido cuando quieras desde Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une bonne façon de commencer : enregistre ton premier repas ou va t'entraîner. Plus tu utilises PowerPump, plus l'accueil t'en dit. Tu peux revoir cette visite quand tu veux depuis les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un buon modo per iniziare: registra il primo pasto di oggi o vai in palestra. Più usi PowerPump, più la Home ti racconta. Puoi rivedere questo tour quando vuoi dalle Impostazioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um bom jeito de começar: registre a primeira refeição de hoje ou vá treinar. Quanto mais você usa o PowerPump, mais o painel te mostra. Dá para rever este tour quando quiser nos Ajustes."
          }
        }
      }
    },
    "tutorial.ready.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That's it, your turn!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Listo, te toca!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voilà, à toi de jouer !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatto, tocca a te!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronto, agora é com você!"
          }
        }
      }
    },
    "tutorial.route.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a distance, like 5 km, and PowerPump builds a loop that starts and ends right where you are. While you run, a voice tells you when to turn so you never get lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una distancia, por ejemplo 5 km, y PowerPump crea un circuito que empieza y termina justo donde estás. Mientras corres, una voz te avisa cuándo girar para que no te pierdas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis une distance, par exemple 5 km, et PowerPump crée une boucle qui part et revient là où tu es. Pendant que tu cours, une voix t'indique quand tourner pour ne jamais te perdre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una distanza, per esempio 5 km, e PowerPump crea un anello che parte e torna proprio dove sei. Mentre corri, una voce ti dice quando girare così non ti perdi mai."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma distância, por exemplo 5 km, e o PowerPump cria um circuito que começa e termina bem onde você está. Enquanto você corre, uma voz avisa quando virar para você não se perder."
          }
        }
      }
    },
    "tutorial.route.hint" : {
