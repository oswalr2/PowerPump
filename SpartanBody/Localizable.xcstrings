    "tutorial.welcome.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gym, running, sports and nutrition, all in one app. Give us two minutes and we'll show you around."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gimnasio, running, deportes y nutrición, todo en una sola app. Dame dos minutos y te enseño dónde está cada cosa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muscu, course, sports et nutrition, tout dans une seule app. Deux minutes et on te fait visiter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palestra, corsa, sport e nutrizione, tutto in una sola app. Dammi due minuti e ti faccio fare un giro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Academia, corrida, esportes e nutrição, tudo em um só app. Me dá dois minutos que eu te mostro tudo."
          }
        }
      }
    },
