    "spartan.ask.buddy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anything you want to ask me?|What's on your mind today?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Hay algo que quieras preguntarme?|¿Qué tienes en mente hoy?"
