    "Drizzle with olive oil and lemon juice. Season and toss.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rocía con aceite de oliva y jugo de limón. Sazona y mezcla."
