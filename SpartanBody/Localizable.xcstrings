    "form.rule.dip.depth.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower until your upper arms are parallel to the floor, as long as your shoulders feel good."
