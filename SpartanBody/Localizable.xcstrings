    "form.rule.deadlift.hipsFirst.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push the floor away with your legs so hips and shoulders rise together. Keep your back tight from the start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empuja el suelo con las piernas para que cadera y hombros suban juntos. Tensa la espalda desde el inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pousse le sol avec les jambes pour que hanches et épaules montent ensemble. Verrouille le dos dès le départ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spingi il pavimento con le gambe così fianchi e spalle salgono insieme. Tieni la schiena tesa dall'inizio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre o chão com as pernas para quadril e ombros subirem juntos. Mantenha as costas firmes desde o início."
          }
        }
      }
    },
    "form.rule.deadlift.hipsFirst.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hips rise before the bar"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
