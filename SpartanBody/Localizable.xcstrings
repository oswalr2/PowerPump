    "form.rule.rdl.range.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push your hips further back until you feel a strong hamstring stretch, with your back flat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva la cadera más atrás hasta notar bien el estiramiento en los isquios, con la espalda recta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recule davantage les hanches jusqu'à sentir un bon étirement des ischios, dos plat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta i fianchi più indietro finché senti bene l'allungamento dei femorali, schiena piatta."
