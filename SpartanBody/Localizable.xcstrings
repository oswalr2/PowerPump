    "Cook chicken 6-7 min per side until golden and cooked through. Rest 2 min, then slice.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocina el pollo 6-7 min por lado hasta que esté dorado y bien cocido. Deja reposar 2 min y córtalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites cuire le poulet 6-7 min par côté jusqu'à ce qu'il soit doré et bien cuit. Laissez reposer 2 min, puis tranchez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuoci il pollo 6-7 min per lato finché è dorato e ben cotto. Fai riposare 2 min, poi affetta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cozinhe o frango 6-7 min de cada lado até dourar e cozinhar por completo. Deixe descansar 2 min e fatie."
          }
        }
      }
    },
