    "form.rule.squat.lockout.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish each rep standing tall, knees and hips straight."
          }
        },
        "es" : {
          "stringUnit" : {
