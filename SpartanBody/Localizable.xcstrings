    "spartan.hello.buddy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey %@, how's it going?|Hi %@! How are you feeling today?|Hey %@, good to have you here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola %@, ¿qué tal todo?|¡Hola %@! ¿Cómo te sientes hoy?|Ey %@, qué bien tenerte por aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut %@, comment ça va ?|Coucou %@ ! Comment tu te sens aujourd'hui ?|Hé %@, content de te voir ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao %@, come va?|Ciao %@! Come ti senti oggi?|Ehi %@, che bello averti qui."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi %@, tudo bem?|Oi %@! Como você está hoje?|E aí %@, bom ter você por aqui."
          }
        }
      }
    },
    "spartan.hello.direct" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Here's today.|Morning, %@. Let's get to work.|%@, today's plan:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Esto es lo de hoy.|Buenas, %@. A trabajar.|%@, el plan de hoy:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Voilà pour aujourd'hui.|Salut, %@. Au travail.|%@, le plan du jour :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Ecco oggi.|Ciao, %@. Al lavoro.|%@, il piano di oggi:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Hoje é isso.|E aí, %@. Ao trabalho.|%@, o plano de hoje:"
          }
        }
      }
    },
    "spartan.hello.motivator" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good to see you, %@! 🔥|%@! Ready to have a great day?|Here we go again, %@! 💪"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Qué bueno verte, %@! 🔥|¡%@! ¿Listo para un gran día?|¡Aquí estamos otra vez, %@! 💪"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Content de te voir, %@ ! 🔥|%@ ! Prêt pour une super journée ?|C'est reparti, %@ ! 💪"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Che bello vederti, %@! 🔥|%@! Pronto per una grande giornata?|Eccoci di nuovo, %@! 💪"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que bom te ver, %@! 🔥|%@! Pronto para um grande dia?|Aqui estamos de novo, %@! 💪"
          }
        }
      }
    },
    "spartan.learned.buddy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks for telling me, I'll remember that. 📝|Good to know. I'll keep it in mind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias por contármelo, me lo apunto. 📝|Bueno saberlo. Lo tendré en cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci de me le dire, je le note. 📝|Bon à savoir. J'en tiendrai compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie per avermelo detto, me lo segno. 📝|Buono a sapersi. Ne terrò conto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valeu por me contar, vou anotar. 📝|Bom saber. Vou levar em conta."
          }
        }
      }
    },
    "spartan.learned.direct" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noted.|Saved. I'll factor it in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apuntado.|Guardado. Lo tengo en cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noté.|Enregistré. J'en tiens compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annotato.|Salvato. Ne tengo conto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anotado.|Salvo. Vou considerar."
          }
        }
      }
    },
    "spartan.learned.motivator" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noted! 📝 I'll keep that in mind from now on.|Got it, I'll remember that. 💪"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Apuntado! 📝 Lo tendré en cuenta a partir de ahora.|Entendido, me lo apunto. 💪"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est noté ! 📝 J'en tiendrai compte désormais.|Compris, je m'en souviendrai. 💪"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annotato! 📝 Ne terrò conto da ora in poi.|Capito, me lo segno. 💪"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anotado! 📝 Vou levar isso em conta daqui pra frente.|Entendido, vou lembrar. 💪"
          }
        }
      }
    },
    "spartan.memory.diet" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "And remember you told me %@: swap anything that doesn't fit for its alternative."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Y recuerda que me dijiste %@: cambia lo que no encaje por su alternativa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et n'oublie pas, tu m'as dit %@ : remplace ce qui ne convient pas par une alternative."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E ricorda che mi hai detto %@: sostituisci ciò che non va con un'alternativa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E lembre que você disse %@: troque o que não encaixar por uma alternativa."
          }
        }
      }
    },
    "spartan.memory.empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing yet. Tell Spartan about injuries, your diet, your schedule or a competition coming up and he'll keep it in mind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía nada. Cuéntale a Spartan si tienes alguna lesión, tu dieta, tu horario o si tienes una competición y lo tendrá en cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien pour l'instant. Parle à Spartan de tes blessures, ton alimentation, ton emploi du temps ou une compétition à venir et il en tiendra compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora niente. Racconta a Spartan di infortuni, dieta, orari o una gara in arrivo e ne terrà conto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada ainda. Conte ao Spartan sobre lesões, sua dieta, seus horários ou uma competição e ele vai levar em conta."
          }
        }
      }
    },
    "spartan.memory.equipment" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Since you told me %@, adapt it to what you have: bodyweight, bands or dumbbells work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como me dijiste %@, adáptalo a lo que tienes: peso corporal, bandas o mancuernas sirven."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme tu m'as dit %@, adapte avec ce que tu as : poids du corps, élastiques ou haltères."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visto che mi hai detto %@, adattalo a quello che hai: corpo libero, elastici o manubri."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como você disse %@, adapte ao que tem: peso corporal, elásticos ou halteres."
          }
        }
      }
    },
    "spartan.memory.event" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't forget what you've got coming up: %@. We're training for that."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No olvides lo que tienes por delante: %@. Para eso entrenamos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'oublie pas ce qui t'attend : %@. C'est pour ça qu'on s'entraîne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non dimenticare cosa ti aspetta: %@. Ci alleniamo per quello."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não esqueça o que vem por aí: %@. É para isso que treinamos."
          }
        }
      }
    },
