    "chat.faq.brag" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beast! 💪 That deserves a celebration. Log it in Training so it counts toward your progress.|That's how it's done! 🔥 Every rep like that adds up. Make sure it's logged so I can track it.|Huge! 🏆 Keep that up and the results come on their own. Log it in the app so I can see your progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Bestia! 💪 Eso se celebra. Apúntalo en Entreno para que cuente en tu progreso.|¡Así se hace! 🔥 Cada repetición así suma. Asegúrate de registrarlo para que pueda seguirlo.|¡Enorme! 🏆 Sigue así y los resultados llegan solos. Regístralo en la app para que vea tu progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Machine ! 💪 Ça se fête. Note-le dans Entraînement pour que ça compte dans ta progression.|C'est comme ça qu'on fait ! 🔥 Chaque répétition comme ça compte. Enregistre-le pour que je puisse suivre.|Énorme ! 🏆 Continue comme ça et les résultats viendront seuls. Enregistre-le dans l'app pour que je voie ta progression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una bestia! 💪 Questo va festeggiato. Registralo in Allenamento così conta per i tuoi progressi.|Così si fa! 🔥 Ogni ripetizione così si somma. Assicurati di registrarlo così posso seguirlo.|Enorme! 🏆 Continua così e i risultati arrivano da soli. Registralo nell'app così vedo i tuoi progressi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monstro! 💪 Isso merece comemoração. Registre em Treino para contar no seu progresso.|É assim que se faz! 🔥 Cada repetição assim soma. Registre para eu acompanhar.|Enorme! 🏆 Continue assim e os resultados vêm sozinhos. Registre no app para eu ver seu progresso."
          }
        }
      }
    },
