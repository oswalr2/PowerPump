    "form.rule.ohp.lockout.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press until your arms are straight, with the weight over the middle of your head."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empuja hasta estirar los brazos, con el peso sobre el centro de la cabeza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pousse jusqu'à tendre les bras, la charge au-dessus du milieu de la tête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spingi fino a distendere le braccia, con il peso sopra il centro della testa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre até esticar os braços, com o peso sobre o centro da cabeça."
          }
        }
      }
    },
    "form.rule.ohp.lockout.title" : {
      "extractionState" : "manual",
      "localizations" : {
