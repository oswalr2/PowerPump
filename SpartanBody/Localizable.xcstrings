    "spartan.today.away.buddy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I haven't seen you train for %lld days. Everything okay? A short session today would feel great."
          }
