    "form.rule.tree.torso.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stack head, shoulders and hips over the standing foot. Press your foot and leg into each other."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alinea cabeza, hombros y cadera sobre el pie de apoyo. Presiona pie y pierna uno contra otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aligne tête, épaules et hanches au-dessus du pied d'appui. Presse le pied et la jambe l'un contre l'autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allinea testa, spalle e fianchi sopra il piede d'appoggio. Premi piede e gamba l'uno contro l'altra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
