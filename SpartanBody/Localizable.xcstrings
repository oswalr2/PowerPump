        }
      }
    },
    "spartan.ask.direct" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What do you need?|Questions? Shoot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué necesitas?|¿Dudas? Dispara."
          }
        },
        "fr" : {
          "stringUnit" : {
