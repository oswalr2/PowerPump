    "tutorial.programs.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Want to go from walking to running 5K? Follow one of the four plans and a voice coach tells you when to walk and when to run in every session. Your progress is saved day by day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres pasar de caminar a correr 5K? Sigue uno de los cuatro planes y un coach de voz te dice cuándo caminar y cuándo correr en cada sesión. Tu progreso se guarda día a día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu veux passer de la marche au 5 km ? Suis l'un des quatre plans et un coach vocal te dit quand marcher et quand courir à chaque séance. Ta progression est enregistrée jour après jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi passare dalla camminata ai 5 km? Segui uno dei quattro piani e un coach vocale ti dice quando camminare e quando correre in ogni sessione. I progressi si salvano giorno per giorno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quer sair da caminhada e correr 5 km? Siga um dos quatro planos e um coach de voz avisa quando caminhar e quando correr em cada sessão. Seu progresso fica salvo dia a dia."
          }
        }
      }
    },
