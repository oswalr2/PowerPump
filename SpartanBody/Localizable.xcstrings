    "form.rule.ohp.lean.fix" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Squeeze glutes and abs so your lower back doesn't arch. If you still lean, the weight is too heavy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprieta glúteos y abdomen para no arquear la zona lumbar. Si aún te inclinas, el peso es excesivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serre fessiers et abdos pour ne pas cambrer le bas du dos. Si tu te penches encore, la charge est trop lourde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stringi glutei e addome per non inarcare la zona lombare. Se ti inclini ancora, il peso è eccessivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contraia glúteos e abdômen para não arquear a lombar. Se ainda inclinar, o peso está alto demais."
          }
        }
      }
    },
    "form.rule.ohp.lean.title" : {
